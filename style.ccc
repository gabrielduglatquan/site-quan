/* --- PALETTE DE COULEURS --- */
:root {
    --fond-clair: #FDFBF7;
    --texte-principal: #333333;
    --rouge-sombre: #7A2021; 
    --orange-terracotta: #ED7E5C; /* Ta nouvelle couleur ! */
    --fond-section: #F3EAE3; 
}

/* --- BASE --- */
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--texte-principal);
    background-color: var(--fond-clair);
    margin: 0;
    padding: 0;
    line-height: 1.6;
}

h1, h2, h3 { color: var(--rouge-sombre); margin-bottom: 1rem; }
a { text-decoration: none; }

/* --- BOUTONS --- */
.btn-primaire {
    display: inline-block;
    background-color: var(--orange-terracotta);
    color: white;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: bold;
    transition: background 0.3s;
    margin: 5px;
}
.btn-primaire:hover {
    background-color: #D66A48; /* Un peu plus foncé au survol */
}

.btn-secondaire {
    display: inline-block;
    background-color: transparent;
    color: var(--rouge-sombre);
    padding: 10px 22px;
    border: 2px solid var(--rouge-sombre);
    border-radius: 8px;
    font-weight: bold;
    transition: all 0.3s;
    margin: 5px;
}
.btn-secondaire:hover {
    background-color: var(--rouge-sombre);
    color: white;
}

/* --- EN-TÊTE / MENU --- */
header {
    background-color: var(--rouge-sombre);
    padding: 15px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}
.logo { color: white; font-size: 1.5rem; font-weight: bold; }
nav { display: flex; flex-wrap: wrap; gap: 15px; }
nav a { color: white; font-size: 0.95rem; transition: color 0.3s; }
nav a:hover { color: var(--orange-terracotta); }

/* --- SECTIONS GLOBALES --- */
section {
    padding: 60px 5%;
    max-width: 1200px;
    margin: 0 auto;
}
.fond-alterne { background-color: var(--fond-section); max-width: 100%; }

/* --- BANDEAU PRINCIPAL (HERO) --- */
.hero { text-align: center; padding: 80px 5%; }
.hero h1 { font-size: 2.8rem; margin-bottom: 20px; }
.hero p { font-size: 1.2rem; max-width: 800px; margin: 0 auto 30px auto; }

/* --- GRILLES (SERVICES ET ÉTAPES) --- */
.grille-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 30px;
}
.carte {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    border-top: 4px solid var(--orange-terracotta);
}

/* --- ADAPTATION MOBILE --- */
@media (max-width: 768px) {
    header { flex-direction: column; text-align: center; }
    nav { justify-content: center; margin-top: 15px; }
    .hero h1 { font-size: 2rem; }
}